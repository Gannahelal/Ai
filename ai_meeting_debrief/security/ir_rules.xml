<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Managers see and manage all debriefs -->
        <record id="rule_ai_meeting_manager_all" model="ir.rule">
            <field name="name">AI Meeting Debrief: Manager sees all</field>
            <field name="model_id" ref="model_ai_meeting_debrief"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ai_meeting_debrief.group_ai_meeting_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Users can read all debriefs -->
        <record id="rule_ai_meeting_user_read_all" model="ir.rule">
            <field name="name">AI Meeting Debrief: User reads all</field>
            <field name="model_id" ref="model_ai_meeting_debrief"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ai_meeting_debrief.group_ai_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Users can write/create/delete their own debriefs -->
        <record id="rule_ai_meeting_user_own" model="ir.rule">
            <field name="name">AI Meeting Debrief: User manages own</field>
            <field name="model_id" ref="model_ai_meeting_debrief"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ai_meeting_debrief.group_ai_meeting_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>