<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_ai_meeting">
        <field name="name">AI Meeting Debrief</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_ai_meeting_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can create and manage their own meeting debriefs; read access to all.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_ai_meeting"/>
    </record>

    <record id="group_ai_meeting_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Full access to all debriefs and module settings.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_meeting"/>
        <field name="implied_ids" eval="[(4, ref('ai_meeting_debrief.group_ai_meeting_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>