<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_meeting_debrief.MeetingDashboard">
    <div class="o_meeting_debrief_dashboard p-4" style="background: var(--o-view-background-color, #f8f9fa); min-height: 100%;">

        <!-- Loading Spinner -->
        <t t-if="state.loading">
            <div class="d-flex justify-content-center align-items-center" style="height: 300px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading…</span>
                </div>
            </div>
        </t>

        <!-- Error State -->
        <t t-elif="state.error">
            <div class="alert alert-danger d-flex align-items-center">
                <i class="fa fa-exclamation-triangle me-2"/>
                <span><t t-esc="state.error"/></span>
            </div>
        </t>

        <!-- Dashboard Content -->
        <t t-elif="state.stats">

            <!-- Header -->
            <div class="d-flex align-items-center mb-3">
                <div>
                    <h2 class="mb-0 fw-bold">Meeting Health Dashboard</h2>
                    <p class="text-muted mb-0 small">AI-powered meeting insights at a glance</p>
                </div>
                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="loadStats">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                    <button class="btn btn-sm btn-primary" t-on-click="openNewMeeting">
                        <i class="fa fa-plus me-1"/> New Debrief
                    </button>
                </div>
            </div>

            <!-- Date Range Filter Bar -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body py-2 px-3 d-flex align-items-center flex-wrap gap-2">
                    <i class="fa fa-calendar text-primary me-1"/>
                    <span class="text-muted small fw-semibold me-1">Date Range:</span>

                    <input type="date"
                           class="form-control form-control-sm"
                           style="max-width: 150px;"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>

                    <span class="text-muted small">→</span>

                    <input type="date"
                           class="form-control form-control-sm"
                           style="max-width: 150px;"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>

                    <div class="vr mx-1"/>

                    <button class="btn btn-sm btn-outline-secondary" t-on-click="setThisMonth">
                        This Month
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="setLast3Months">
                        Last 3 Months
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="setThisYear">
                        This Year
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="setAllTime">
                        All Time
                    </button>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="row g-3 mb-4">

                <div class="col-xl-3 col-sm-6">
                    <div class="card h-100 shadow-sm cursor-pointer border-0"
                         style="border-left: 4px solid #0d6efd !important;"
                         t-on-click="openAllMeetings">
                        <div class="card-body text-center py-3">
                            <div class="display-5 fw-bold text-primary">
                                <t t-esc="state.stats.total_meetings"/>
                            </div>
                            <div class="text-muted mt-1 small fw-medium">Total Meetings</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-sm-6">
                    <div class="card h-100 shadow-sm cursor-pointer border-0"
                         style="border-left: 4px solid #0dcaf0 !important;"
                         t-on-click="openAnalyzedMeetings">
                        <div class="card-body text-center py-3">
                            <div class="display-5 fw-bold text-info">
                                <t t-esc="state.stats.analyzed_in_period"/>
                            </div>
                            <div class="text-muted mt-1 small fw-medium">Analyzed</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-sm-6">
                    <div class="card h-100 shadow-sm cursor-pointer border-0"
                         style="border-left: 4px solid #ffc107 !important;"
                         t-on-click="openPendingActions">
                        <div class="card-body text-center py-3">
                            <div class="display-5 fw-bold text-warning">
                                <t t-esc="state.stats.pending_actions"/>
                            </div>
                            <div class="text-muted mt-1 small fw-medium">Pending Actions</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-sm-6">
                    <div class="card h-100 shadow-sm cursor-pointer border-0"
                         style="border-left: 4px solid #dc3545 !important;"
                         t-on-click="openHRAlerts">
                        <div class="card-body text-center py-3">
                            <div class="display-5 fw-bold text-danger">
                                <t t-esc="state.stats.hr_alerts"/>
                            </div>
                            <div class="text-muted mt-1 small fw-medium">HR Alerts</div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Bottom Row: Action Items Overview + Recent Meetings -->
            <div class="row g-3">

                <!-- Action Items Overview -->
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white fw-semibold border-bottom">
                            Action Items Overview
                        </div>
                        <div class="card-body d-flex flex-column justify-content-center">

                            <div class="text-center mb-3">
                                <div class="display-4 fw-bold text-primary">
                                    <t t-esc="state.stats.action_stats.completion_pct"/>%
                                </div>
                                <div class="text-muted small fw-medium">Completion Rate</div>
                            </div>

                            <div class="progress mb-4" style="height: 14px; border-radius: 7px;">
                                <div class="progress-bar bg-success"
                                     role="progressbar"
                                     t-att-style="'width: ' + state.stats.action_stats.completion_pct + '%'"
                                     t-att-aria-valuenow="state.stats.action_stats.completion_pct"
                                     aria-valuemin="0"
                                     aria-valuemax="100"/>
                            </div>

                            <div class="row text-center g-0">
                                <div class="col-4 border-end">
                                    <div class="fw-bold fs-5 text-secondary">
                                        <t t-esc="state.stats.action_stats.total"/>
                                    </div>
                                    <div class="text-muted small">Total</div>
                                </div>
                                <div class="col-4 border-end">
                                    <div class="fw-bold fs-5 text-success">
                                        <t t-esc="state.stats.action_stats.done"/>
                                    </div>
                                    <div class="text-muted small">Done</div>
                                </div>
                                <div class="col-4 cursor-pointer" t-on-click="openPendingActions">
                                    <div class="fw-bold fs-5 text-warning">
                                        <t t-esc="state.stats.action_stats.pending"/>
                                    </div>
                                    <div class="text-muted small">Pending</div>
                                </div>
                            </div>

                            <div t-if="state.stats.action_stats.total === 0"
                                 class="text-center text-muted py-2 mt-2 small">
                                No action items in this period.
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Recent Meetings -->
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white fw-semibold border-bottom">
                            Recent Meetings
                            <span class="text-muted fw-normal small ms-2">
                                (<t t-esc="state.stats.total_meetings"/> in selected period)
                            </span>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Meeting</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.stats.recent_meetings.length === 0">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                No meetings in this period.
                                                <span class="ms-1 text-primary cursor-pointer"
                                                      t-on-click="openNewMeeting">
                                                    Create your first one!
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.stats.recent_meetings"
                                       t-as="meeting"
                                       t-key="meeting.id">
                                        <tr class="cursor-pointer"
                                            t-on-click="() => openMeeting(meeting.id)">
                                            <td class="ps-3" style="max-width: 220px;">
                                                <div class="text-truncate fw-medium">
                                                    <t t-esc="meeting.name"/>
                                                </div>
                                            </td>
                                            <td class="text-muted small align-middle">
                                                <t t-esc="meeting.date"/>
                                            </td>
                                            <td class="align-middle">
                                                <span t-att-class="'badge ' + (meeting.state === 'done' ? 'bg-success' : 'bg-secondary')">
                                                    <t t-esc="meeting.state_label"/>
                                                </span>
                                            </td>
                                            <td class="align-middle">
                                                <span class="badge bg-light text-dark border">
                                                    <t t-esc="meeting.action_item_count"/>
                                                    <t t-if="meeting.action_item_count === 1"> item</t>
                                                    <t t-else=""> items</t>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-white border-top text-end">
                            <span class="text-primary small cursor-pointer" t-on-click="openAllMeetings">
                                View all meetings →
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </t>

    </div>
</t>

</templates>
